---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

// SEO関連の定数
const siteName = "月ウサギのそだてかた 攻略";
const defaultDescription =
  "月ウサギのそだてかた - 武器合成の計画とガチャ分析ができる非公式ファン攻略サイト";
const pageDescription = description || defaultDescription;
const fullTitle = `${title} | ${siteName}`;
const canonicalUrl = new URL(currentPath, Astro.site).href;
const ogImageUrl = new URL("/og-image.jpeg", Astro.site).href;

// GA4測定ID（TODO: 実際のIDに置き換えてください）
const GA_MEASUREMENT_ID = "G-M9EMKXS84R";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OGP (Open Graph Protocol) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Google Analytics (GA4) -->
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", GA_MEASUREMENT_ID);
    </script>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <div class="flex min-h-screen flex-col md:flex-row">
      <!-- モバイル用ヘッダー -->
      <header
        class="bg-white border-b border-gray-200 p-4 flex items-center justify-between md:hidden sticky top-0 z-30"
      >
        <a
          href="/"
          class="text-lg font-bold text-gray-800 hover:text-blue-600 transition-colors"
          >月ウサ攻略</a
        >
        <button
          id="menu-toggle"
          class="p-2 rounded-md hover:bg-gray-100 text-gray-600 focus:outline-none"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </header>

      <!-- オーバーレイ (モバイル表示時) -->
      <div
        id="sidebar-overlay"
        class="fixed inset-0 bg-black/50 z-40 hidden md:hidden transition-opacity opacity-0 mx-0 my-0"
      >
      </div>

      <!-- サイドバー -->
      <aside
        id="sidebar"
        class="bg-white border-r border-gray-200 fixed inset-y-0 left-0 z-50 w-64 transform -translate-x-full transition-transform duration-300 md:translate-x-0 md:static md:h-screen md:sticky md:top-0"
      >
        <div class="p-6 flex justify-between items-start">
          <div>
            <h1 class="text-xl font-bold text-gray-800 mb-2">
              月ウサギのそだてかた
            </h1>
            <p class="text-sm text-gray-600">攻略情報</p>
          </div>
          <button
            id="menu-close"
            class="md:hidden text-gray-400 hover:text-gray-600"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <nav class="px-4 pb-20 overflow-y-auto h-[calc(100vh-100px)]">
          <!-- ホーム -->
          <a
            href="/"
            class={`block px-4 py-2 rounded-md transition-colors ${
              currentPath === "/"
                ? "bg-blue-50 text-blue-700 font-medium"
                : "text-gray-700 hover:bg-gray-100"
            }`}
          >
            ホーム
          </a>

          <!-- 区切り線 -->
          <div class="border-t border-gray-200 my-3"></div>

          <!-- 武器セクション -->
          <div class="mb-2">
            <p
              class="px-4 py-1 text-xs font-semibold text-gray-500 uppercase tracking-wider"
            >
              武器
            </p>
          </div>
          <ul class="space-y-1">
            <li>
              <a
                href="/weapons"
                class={`block px-4 py-2 rounded-md transition-colors ${
                  currentPath === "/weapons" || currentPath === "/weapons/"
                    ? "bg-blue-50 text-blue-700 font-medium"
                    : "text-gray-700 hover:bg-gray-100"
                }`}
              >
                武器図鑑
              </a>
            </li>
            <li>
              <a
                href="/weapons/goal"
                class={`block px-4 py-2 rounded-md transition-colors ${
                  currentPath === "/weapons/goal" ||
                  currentPath === "/weapons/goal/"
                    ? "bg-blue-50 text-blue-700 font-medium"
                    : "text-gray-700 hover:bg-gray-100"
                }`}
              >
                武器目標計算
              </a>
            </li>
            <li>
              <a
                href="/weapons/gacha"
                class={`block px-4 py-2 rounded-md transition-colors ${
                  currentPath === "/weapons/gacha" ||
                  currentPath === "/weapons/gacha/"
                    ? "bg-blue-50 text-blue-700 font-medium"
                    : "text-gray-700 hover:bg-gray-100"
                }`}
              >
                武器ガチャシミュレータ
              </a>
            </li>
          </ul>
        </nav>
      </aside>

      <!-- メインコンテンツ -->
      <main class="flex-1 w-full p-4 md:p-8 overflow-x-hidden">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold mb-6">{title}</h2>
          <slot />
        </div>
      </main>
    </div>

    <!-- モバイルメニュー制御スクリプト -->
    <script>
      const menuToggle = document.getElementById("menu-toggle");
      const menuClose = document.getElementById("menu-close");
      const sidebar = document.getElementById("sidebar");
      const overlay = document.getElementById("sidebar-overlay");

      function toggleMenu() {
        if (!sidebar || !overlay) return;
        const isClosed = sidebar.classList.contains("-translate-x-full");

        if (isClosed) {
          sidebar.classList.remove("-translate-x-full");
          overlay.classList.remove("hidden");
          // 少し遅らせてopacityを変更してフェードインさせる
          setTimeout(() => {
            overlay.classList.remove("opacity-0");
          }, 10);
        } else {
          sidebar.classList.add("-translate-x-full");
          overlay.classList.add("opacity-0");
          setTimeout(() => {
            overlay.classList.add("hidden");
          }, 300);
        }
      }

      menuToggle?.addEventListener("click", toggleMenu);
      menuClose?.addEventListener("click", toggleMenu);
      overlay?.addEventListener("click", toggleMenu);
    </script>
  </body>
</html>
