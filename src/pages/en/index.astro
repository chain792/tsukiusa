---
import Layout from "../../layouts/Layout.astro";
import { HomePage } from "../../components/home";
import { getTranslations } from "../../i18n";
import headerImage from "../../assets/tsukiusa_1500x500.jpeg";
import L1Image from "../../assets/L1.png";
import studyingImage from "../../assets/studying.webp";
import gachaImage from "../../assets/weapon_gacha.webp";

const t = getTranslations('en');
const images = {
  header: { src: headerImage.src, alt: "How to Raise a Moon Rabbit" },
  catalog: { src: L1Image.src },
  goal: { src: studyingImage.src },
  gacha: { src: gachaImage.src },
};
---

<Layout title={t.home.title} description={t.home.description}>
  <HomePage locale="en" images={images} />
</Layout>
